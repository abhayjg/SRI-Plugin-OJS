msgid "plugins.pubIds.sri.displayName"
msgstr "SRI-Plugin"

msgid "plugins.pubIds.sri.description"
msgstr "Registers a Scitekhub Research Identifier (SRI) for each published article, automatically at publication time, via the SRI registration API — the same way publishers already expect a Crossref or DataCite DOI plugin to behave. Registration is always best-effort and never blocks publishing."

msgid "plugins.pubIds.sri.fullName"
msgstr "Scitekhub Research Identifier"

msgid "plugins.pubIds.sri.status.label"
msgstr "SRI status"

msgid "plugins.pubIds.sri.status.notRegistered"
msgstr "Not registered"

msgid "plugins.pubIds.sri.status.queued"
msgstr "Queued for registration"

msgid "plugins.pubIds.sri.status.pending"
msgstr "Pending SRI review"

